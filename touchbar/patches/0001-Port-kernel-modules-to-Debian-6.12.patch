 kernel/uvcvideo-t1/uvc_v4l2.c     | 702 ++++++++++++++++------
 kernel/uvcvideo-t1/uvc_video.c    | 124 ++--
 kernel/uvcvideo-t1/uvcvideo.h     | 132 ++--
 12 files changed, 1372 insertions(+), 1604 deletions(-)

diff --git a/kernel/appletbdrm-t1/appletbdrm.c b/kernel/appletbdrm-t1/appletbdrm.c
index fd28853..1d433fa 100644
--- a/kernel/appletbdrm-t1/appletbdrm.c
+++ b/kernel/appletbdrm-t1/appletbdrm.c
@@ -550,10 +550,17 @@ static int appletbdrm_probe(struct usb_interface *intf,
 	usb_set_intfdata(intf, adev);
 
 	dma_dev = usb_intf_get_dma_device(intf);
+#if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 16, 0)
 	if (dma_dev) {
 		drm_dev_set_dma_dev(drm, dma_dev);
 		put_device(dma_dev);
 	} else {
+#else
+	/* drm_dev_set_dma_dev() neegzistuoja < 6.16: PRIME importas išjungtas. */
+	if (dma_dev)
+		put_device(dma_dev);
+	{
+#endif
 		drm_warn(drm, "buffer sharing not supported"); /* not an error */
 	}
 
