+static void expect_key_event(int descriptor, uint16_t code, int value)
+{
+	struct input_event events[2];
+
+	read_complete(descriptor, events, sizeof(events));
+	EXPECT_TRUE(events[0].type == EV_KEY && events[0].code == code &&
+		    events[0].value == value);
+	EXPECT_TRUE(events[1].type == EV_SYN && events[1].code == SYN_REPORT);
+}
+
+static void test_uinput_chord(void)
+{
+	int descriptors[2];
+	struct t1_touchbar_uinput *device;
+	const unsigned short chord[] = { KEY_LEFTCTRL, KEY_LEFTALT, KEY_T };
+	const unsigned short unknown[] = { KEY_LEFTCTRL, KEY_POWER };
+	const unsigned short duplicate[] = { KEY_A, KEY_A };
+	const unsigned short five[] = { KEY_A, KEY_B, KEY_C, KEY_D, KEY_E };
+
+	EXPECT_TRUE(pipe2(descriptors, O_CLOEXEC | O_NONBLOCK) == 0);
+	device = t1_touchbar_uinput_test_device(descriptors[1]);
+	EXPECT_TRUE(device != NULL);
+	EXPECT_TRUE(t1_touchbar_uinput_chord(device, chord, 3U) ==
+		    T1_TOUCHBAR_IO_OK);
+	expect_key_event(descriptors[0], KEY_LEFTCTRL, 1);
+	expect_key_event(descriptors[0], KEY_LEFTALT, 1);
+	expect_key_event(descriptors[0], KEY_T, 1);
+	expect_key_event(descriptors[0], KEY_T, 0);
+	expect_key_event(descriptors[0], KEY_LEFTALT, 0);
+	expect_key_event(descriptors[0], KEY_LEFTCTRL, 0);
+	EXPECT_TRUE(t1_touchbar_uinput_test_held(device) == 0U);
+	EXPECT_TRUE(t1_touchbar_uinput_chord(device, unknown, 2U) ==
+		    T1_TOUCHBAR_IO_ERROR_ARGUMENT);
+	EXPECT_TRUE(t1_touchbar_uinput_chord(device, duplicate, 2U) ==
+		    T1_TOUCHBAR_IO_ERROR_ARGUMENT);
+	EXPECT_TRUE(t1_touchbar_uinput_chord(device, five, 5U) ==
+		    T1_TOUCHBAR_IO_ERROR_ARGUMENT);
+	EXPECT_TRUE(t1_touchbar_uinput_chord(device, chord, 0U) ==
+		    T1_TOUCHBAR_IO_ERROR_ARGUMENT);
+	{
+		struct input_event leftover;
+
+		/* Rejected chords emit nothing. */
+		EXPECT_TRUE(read(descriptors[0], &leftover, sizeof(leftover)) < 0);
+	}
+	EXPECT_TRUE(t1_touchbar_uinput_close(device) == T1_TOUCHBAR_IO_OK);
+	EXPECT_TRUE(close(descriptors[0]) == 0);
+}
