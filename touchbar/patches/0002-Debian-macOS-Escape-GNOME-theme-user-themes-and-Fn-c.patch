index 0000000..d7a2b35
--- /dev/null
+++ b/debian/install-touchbar.sh
@@ -0,0 +1,83 @@
+#!/bin/bash
+# T1Bridge Touch Bar (+ T1 kamera) diegimas Debian 13 / branduolys 6.12.
+# Tik Touch Bar dalis: be Touch ID (fprintd/libfprint pakaitalų, keybag, xART paslaugų).
+# Paleisti iš šakos debian-6.12, po:
+#   cargo build --locked --release -p t1-touchbar-hw --bin t1-touchbar-hw --features service
+#   cargo build --locked --release -p t1-touchbar --bin t1-touchbar
+# Atšaukti: debian/uninstall-touchbar.sh
+set -euo pipefail
+
+[ "$(id -u)" = 0 ] || { echo "Paleisk per sudo" >&2; exit 1; }
+SRC=$(cd "$(dirname "$0")/.." && pwd)
+VER=0.1.12+deb612
+DKMS_DIR=/usr/src/t1bridge-dkms-$VER
+USER_NAME=${SUDO_USER:?paleisk per sudo iš savo paskyros}
+
+for b in t1-touchbar-hw t1-touchbar; do
+	[ -x "$SRC/target/release/$b" ] || { echo "Nėra $b — pirma cargo build" >&2; exit 1; }
+done
+
+echo "== 1. DKMS moduliai ($VER)"
+rm -rf "$DKMS_DIR"
+mkdir -p "$DKMS_DIR/kernel"
+for d in t1-cfgsel appletbdrm-t1 apple-t1-ncm uvcvideo-t1 dkms; do
+	mkdir -p "$DKMS_DIR/kernel/$d"
+	find "$SRC/kernel/$d" -maxdepth 1 -type f \( -name '*.c' -o -name '*.h' -o -name Makefile \) \
+		! -name 'test_*' ! -name '*.mod.c' -exec install -m644 {} "$DKMS_DIR/kernel/$d/" \;
+done
+sed "s/^PACKAGE_VERSION=.*/PACKAGE_VERSION=\"$VER\"/" "$SRC/kernel/dkms/dkms.conf" > "$DKMS_DIR/dkms.conf"
+dkms add -m t1bridge-dkms -v "$VER"
+dkms install -m t1bridge-dkms -v "$VER" -k "$(uname -r)"
+
+echo "== 2. Modulių įkėlimas ir legacy draiverių blokavimas"
+install -Dm644 "$SRC/packaging/arch/t1bridge-dkms/t1bridge.modules-load.conf" /etc/modules-load.d/t1bridge.conf
+install -Dm644 "$SRC/packaging/arch/t1bridge-dkms/t1bridge.modprobe.conf" /etc/modprobe.d/t1bridge.conf
+# t1_cfgsel turi būti prieš iBridge enumeraciją -> į initramfs
+grep -qx t1_cfgsel /etc/initramfs-tools/modules || echo t1_cfgsel >> /etc/initramfs-tools/modules
+update-initramfs -u -k "$(uname -r)"
+
+echo "== 3. Programos"
+install -Dm755 "$SRC/target/release/t1-touchbar-hw" /usr/lib/t1bridge/t1-touchbar-hw
+install -Dm755 "$SRC/target/release/t1-touchbar" /usr/lib/t1bridge/t1-touchbar
+# Garsas (wpctl) ir grotuvas (MPRIS) — be jo Touch Bar slepia garso mygtukus
+install -Dm755 "$SRC/debian/t1bridge-desktop-provider" /usr/lib/t1bridge/desktop-provider
+install -d /etc/systemd/user/t1-touchbar.service.d
+printf '[Service]\nEnvironment=T1BRIDGE_DESKTOP_PROVIDER=/usr/lib/t1bridge/desktop-provider\n' \
+	> /etc/systemd/user/t1-touchbar.service.d/desktop-provider.conf
+
+echo "== 4. systemd / udev / sysusers / tmpfiles"
+install -Dm644 "$SRC/systemd/t1-touchbar-hw.service" /etc/systemd/system/t1-touchbar-hw.service
+install -Dm644 "$SRC/systemd/t1-touchbar-hw.socket" /etc/systemd/system/t1-touchbar-hw.socket
+install -Dm644 "$SRC/systemd/user/t1-touchbar.service" /etc/systemd/user/t1-touchbar.service
+install -Dm644 "$SRC/systemd/t1bridge.sysusers" /etc/sysusers.d/t1bridge.conf
+install -Dm644 "$SRC/systemd/t1bridge.conf" /etc/tmpfiles.d/t1bridge.conf
+install -Dm644 "$SRC/systemd/99-zz-t1bridge-touchbar.rules" /etc/udev/rules.d/99-zz-t1bridge-touchbar.rules
+systemd-sysusers /etc/sysusers.d/t1bridge.conf
+systemd-tmpfiles --create /etc/tmpfiles.d/t1bridge.conf
+usermod -aG t1bridge "$USER_NAME"
+systemctl daemon-reload
+udevadm control --reload
+systemctl enable t1-touchbar-hw.service
+systemctl --global enable t1-touchbar.service
+
+echo "== 5. usbmuxd udev pataisa (be jos T1 pakyla su bConfigurationValue=0 -> nėra kameros/Touch Bar)"
+if [ -f /usr/lib/udev/rules.d/39-usbmuxd.rules ]; then
+	{
+		echo "# LOCAL OVERRIDE (t1bridge debian): pašalintas 5ac/8600 (MacBookPro T1 iBridge)."
+		echo "# Originali taisyklė jam nustato bConfigurationValue=0 -> dingsta kamera ir Touch Bar."
+		sed 's#|5ac/8600/\*##' /usr/lib/udev/rules.d/39-usbmuxd.rules
+	} > /etc/udev/rules.d/39-usbmuxd.rules
+	udevadm control --reload
+fi
+
+echo "== 6. Vartotojo konfigas (jei dar nėra)"
+USER_HOME=$(getent passwd "$USER_NAME" | cut -d: -f6)
+CONF_DIR="$USER_HOME/.config/t1bridge"
+if [ ! -e "$CONF_DIR/touchbar.conf" ]; then
+	install -d -o "$USER_NAME" -g "$USER_NAME" "$CONF_DIR" "$CONF_DIR/themes" "$CONF_DIR/icons"
+	install -m644 -o "$USER_NAME" -g "$USER_NAME" "$SRC/debian/touchbar.conf.example" "$CONF_DIR/touchbar.conf"
+	install -m644 -o "$USER_NAME" -g "$USER_NAME" "$SRC/debian/themes-README.txt" "$CONF_DIR/themes/README.txt"
+fi
+
+echo "== Baigta. Perkrauk. Po to: lsusb -t (T1 config 2), ls /dev/dri/touchbar /dev/video*,"
+echo "   systemctl status t1-touchbar-hw; systemctl --user status t1-touchbar"
diff --git a/debian/t1bridge-desktop-provider b/debian/t1bridge-desktop-provider
new file mode 100755
index 0000000..24788d9
--- /dev/null
+++ b/debian/t1bridge-desktop-provider
@@ -0,0 +1,46 @@
+#!/bin/bash
+# T1Bridge desktop provider v1 (docs/interfaces.md "Desktop provider v1").
+# Garsas per wpctl (PipeWire), grotuvas per MPRIS (gdbus). Be root'o.
+set -u
+SINK=@DEFAULT_AUDIO_SINK@
+
+[ "${1:-}" = v1 ] || exit 2
+op=${2:-}
+
+mpris_player() {
+	gdbus call --session --timeout 1 --dest org.freedesktop.DBus \
+		--object-path /org/freedesktop/DBus --method org.freedesktop.DBus.ListNames 2>/dev/null |
+		grep -o "org\.mpris\.MediaPlayer2\.[^']*" | head -n1
+}
+
+mpris() {
+	local p
+	p=$(mpris_player) || exit 1
+	[ -n "$p" ] || exit 1
+	gdbus call --session --timeout 1 --dest "$p" --object-path /org/mpris/MediaPlayer2 \
+		--method "org.mpris.MediaPlayer2.Player.$1" >/dev/null
+}
+
+case "$op" in
+status)
+	caps=0 vol=- muted=-
+	if out=$(wpctl get-volume "$SINK" 2>/dev/null); then
+		caps=1
+		v=$(awk '{print $2}' <<<"$out")
+		vol=$(awk -v v="$v" 'BEGIN { x = int(v * 100 + 0.5); if (x > 100) x = 100; print x }')
+		[[ $out == *MUTED* ]] && muted=1 || muted=0
+	fi
+	[ -n "$(mpris_player)" ] && caps=$((caps | 2))
+	echo "T1BRIDGE-DESKTOP 1 $caps $vol $muted"
+	;;
+set-volume)
+	[[ ${3:-} =~ ^([0-9]|[1-9][0-9]|100)$ ]] || exit 2
+	wpctl set-volume "$SINK" "$3%"
+	;;
+toggle-mute) wpctl set-mute "$SINK" toggle ;;
+media-previous) mpris Previous ;;
+media-play-pause) mpris PlayPause ;;
+media-next) mpris Next ;;
+show-display-brightness | show-keyboard-backlight | notify-renderer-fallback) exit 0 ;;
+*) exit 2 ;;
+esac
