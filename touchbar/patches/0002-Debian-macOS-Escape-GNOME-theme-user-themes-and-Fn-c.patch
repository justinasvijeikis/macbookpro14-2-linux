+    /// Presses up to four distinct allowlisted Linux key codes together, then
+    /// releases them in reverse order.
+    ///
+    /// # Errors
+    ///
+    /// Returns [`TouchBarIoError`] for an unknown, duplicate, held, or
+    /// excessive key set, or when the event sequence cannot be written.
+    pub fn chord(&mut self, codes: &[u16]) -> Result<(), TouchBarIoError> {
+        let native = self.native.ok_or(TouchBarIoError::Closed)?;
+        match NativeStatus::from_status(ffi::chord_touchbar_keys(native.as_ptr(), codes))? {
