+//! User configuration: theme selection, theme art, and Fn-row bindings.
+//!
+//! `${XDG_CONFIG_HOME:-~/.config}/t1bridge/touchbar.conf`:
+//!
+//! ```text
+//! theme = penguin                 # default | penguin | a directory under themes/
+//! fn.f1 = keys ctrl+alt+t         # up to four keys pressed together
+//! fn.f2 = exec firefox            # command run through `sh -c` as the user
+//! fn.f2.icon = icons/firefox.png  # optional PNG shown instead of "F2"
+//! ```
+//!
+//! A theme is `themes/<name>/theme.conf` plus its PNG files:
+//!
+//! ```text
+//! style = gnome          # gnome | dark | light
+//! accent = gnome         # gnome | #rrggbb
+//! background = bg.png    # whole-bar image behind the buttons
+//! background.opacity = 100
+//! buttons.opacity = 100  # lower lets the background show through buttons
+//! watermark = penguin    # none | penguin | file.png, drawn behind each label
+//! watermark.scale = 0.9  # times the button height; above 1 is cropped
+//! watermark.opacity = 13
+//! watermark.x = 0        # pixel offset from the button center
+//! watermark.y = 0
+//! mascot = tux           # none | tux | file.png, in the gap after Escape
+//! ```
+//!
+//! Relative paths resolve against the file that names them. Errors are reported
+//! to the journal and the affected setting falls back to its default.
+
+use std::collections::BTreeMap;
+use std::env;
+use std::fs;
+use std::path::{Path, PathBuf};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, Mutex};
+use std::thread;
+use std::time::{Duration, SystemTime};
+
+use t1_touchbar_hw::wire::{KeyCode, MAX_KEYS};
+
+use crate::framebuffer::Rgb;
+use crate::png::{self, Image};
+
+const POLL_INTERVAL: Duration = Duration::from_secs(1);
+const MAX_FILE_BYTES: u64 = 32 * 1024 * 1024;
+const FUNCTION_KEYS: usize = 12;
+
+/// What a Fn-row key does when it is bound.
+#[derive(Clone, Debug, Eq, PartialEq)]
+pub enum FnAction {
+    Keys(Vec<KeyCode>),
+    Exec(String),
+}
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub enum Style {
+    Gnome,
+    Dark,
+    Light,
+}
+
+/// Decorative art slot.
+#[derive(Clone, Debug, Default)]
+pub enum Art {
+    #[default]
+    None,
+    /// Built-in penguin silhouette (watermark) or Tux mascot.
+    Builtin,
+    Image(Arc<Image>),
+}
+
+/// Everything the theme adds on top of the stock layout.
+#[derive(Clone, Debug)]
+pub struct Decor {
+    pub style: Style,
+    pub accent: Option<Rgb>,
+    pub background: Option<Arc<Image>>,
+    pub background_opacity: u8,
+    pub plate_opacity: u8,
+    pub watermark: Art,
+    pub watermark_scale: f32,
+    pub watermark_opacity: u8,
+    pub watermark_offset: (i32, i32),
+    pub mascot: Art,
+    pub fn_icons: [Option<Arc<Image>>; FUNCTION_KEYS],
+}
+
+impl Default for Decor {
+    fn default() -> Self {
+        Self {
+            style: Style::Gnome,
+            accent: None,
+            background: None,
+            background_opacity: 255,
+            plate_opacity: 255,
+            watermark: Art::None,
+            watermark_scale: 0.9,
+            watermark_opacity: percent_to_alpha(13),
+            watermark_offset: (0, 0),
+            mascot: Art::None,
+            fn_icons: Default::default(),
+        }
+    }
+}
+
+/// One fully loaded configuration.
+#[derive(Clone, Debug, Default)]
+pub struct Config {
+    pub decor: Arc<Decor>,
+    pub fn_actions: [Option<FnAction>; FUNCTION_KEYS],
+}
+
+fn percent_to_alpha(percent: u32) -> u8 {
+    u8::try_from(percent.min(100) * 255 / 100).unwrap_or(255)
+}
+
+fn config_dir() -> Option<PathBuf> {
+    env::var_os("XDG_CONFIG_HOME")
+        .map(PathBuf::from)
+        .filter(|path| path.is_absolute())
+        .or_else(|| env::var_os("HOME").map(|home| PathBuf::from(home).join(".config")))
+        .map(|base| base.join("t1bridge"))
+}
+
+/// Parses `key = value` lines, skipping blanks and `#` comments.
+fn parse_pairs(text: &str, warnings: &mut Vec<String>, origin: &Path) -> BTreeMap<String, String> {
+    let mut pairs = BTreeMap::new();
+    for (number, line) in text.lines().enumerate() {
+        let line = line.trim();
+        if line.is_empty() || line.starts_with('#') {
+            continue;
+        }
+        let Some((key, value)) = line.split_once('=') else {
+            warnings.push(format!("{}:{}: expected key = value", origin.display(), number + 1));
+            continue;
+        };
+        // A trailing comment needs whitespace before '#', so `#rrggbb` values survive.
+        let value = value.trim();
+        let value = value.split(" #").next().unwrap_or_default().trim();
+        pairs.insert(key.trim().to_ascii_lowercase(), value.to_owned());
+    }
+    pairs
+}
+
+/// Parses `ctrl+alt+t` into at most four distinct allowlisted keys.
+fn parse_keys(spec: &str) -> Result<Vec<KeyCode>, String> {
+    let mut keys = Vec::new();
+    for name in spec.split('+').map(str::trim) {
+        let key = KeyCode::from_name(name).ok_or_else(|| format!("unknown key '{name}'"))?;
+        if keys.contains(&key) {
+            return Err(format!("key '{name}' repeated"));
+        }
+        keys.push(key);
+    }
+    if keys.is_empty() || keys.len() > MAX_KEYS {
+        return Err(format!("use 1 to {MAX_KEYS} keys"));
+    }
+    Ok(keys)
+}
+
+fn parse_action(value: &str) -> Result<FnAction, String> {
+    let (kind, rest) = value.split_once(char::is_whitespace).unwrap_or((value, ""));
+    let rest = rest.trim();
+    match kind {
+        "keys" => parse_keys(rest).map(FnAction::Keys),
+        "exec" if !rest.is_empty() => Ok(FnAction::Exec(rest.to_owned())),
+        _ => Err("expected 'keys a+b' or 'exec command'".to_owned()),
+    }
+}
+
+fn parse_color(value: &str) -> Option<Rgb> {
+    let hex = value.strip_prefix('#')?;
+    if hex.len() != 6 {
+        return None;
+    }
+    let channel = |range| u8::from_str_radix(hex.get(range)?, 16).ok();
+    Some(Rgb {
+        red: channel(0..2)?,
+        green: channel(2..4)?,
+        blue: channel(4..6)?,
+    })
+}
+
+/// Loads files and records each path consulted so changes trigger a reload.
+struct Loader {
+    warnings: Vec<String>,
+    watched: Vec<PathBuf>,
+}
+
+impl Loader {
+    fn read_text(&mut self, path: &Path) -> Option<String> {
+        self.watched.push(path.to_path_buf());
+        let metadata = fs::metadata(path).ok()?;
+        if metadata.len() > MAX_FILE_BYTES {
+            self.warnings.push(format!("{}: file too large", path.display()));
+            return None;
+        }
+        match fs::read_to_string(path) {
+            Ok(text) => Some(text),
+            Err(error) => {
+                self.warnings.push(format!("{}: {error}", path.display()));
+                None
+            }
+        }
+    }
+
+    fn image(&mut self, base: &Path, value: &str) -> Option<Arc<Image>> {
+        let path = resolve(base, value);
+        self.watched.push(path.clone());
+        let bytes = fs::metadata(&path)
+            .ok()
+            .filter(|metadata| metadata.len() <= MAX_FILE_BYTES)
+            .and_then(|_| fs::read(&path).ok());
+        let Some(bytes) = bytes else {
+            self.warnings
+                .push(format!("{}: cannot read image", path.display()));
+            return None;
+        };
+        match png::decode(&bytes) {
+            Ok(image) => Some(Arc::new(image)),
+            Err(error) => {
+                self.warnings.push(format!("{}: {error}", path.display()));
+                None
+            }
+        }
+    }
+
+    fn number<T: std::str::FromStr>(&mut self, pairs: &BTreeMap<String, String>, key: &str) -> Option<T> {
+        let value = pairs.get(key)?;
+        let parsed = value.parse().ok();
+        if parsed.is_none() {
+            self.warnings.push(format!("{key}: '{value}' is not a number"));
+        }
+        parsed
+    }
+
+    fn art(&mut self, base: &Path, value: Option<&String>, builtin: &str) -> Option<Art> {
+        let value = value?;
+        Some(match value.as_str() {
+            "none" => Art::None,
+            name if name == builtin => Art::Builtin,
+            file => self.image(base, file).map_or(Art::None, Art::Image),
+        })
+    }
+
+    fn theme(&mut self, directory: Option<&Path>, name: &str) -> Decor {
+        let mut decor = Decor::default();
+        let text = directory.and_then(|directory| {
+            let path = directory.join("theme.conf");
+            self.watched.push(directory.to_path_buf());
+            self.read_text(&path).map(|text| (text, path))
+        });
+        let pairs = match (text, name) {
+            (Some((text, path)), _) => parse_pairs(&text, &mut self.warnings, &path),
+            (None, "default") => BTreeMap::new(),
+            (None, "penguin") => parse_pairs(
+                "watermark = penguin\nmascot = tux\n",
+                &mut self.warnings,
+                Path::new("builtin"),
+            ),
+            (None, other) => {
+                self.warnings.push(format!("theme '{other}' not found; using default"));
+                BTreeMap::new()
+            }
+        };
+        let base = directory.unwrap_or_else(|| Path::new("/"));
+        decor.style = match pairs.get("style").map(String::as_str) {
+            None | Some("gnome") => Style::Gnome,
+            Some("dark") => Style::Dark,
+            Some("light") => Style::Light,
+            Some(other) => {
+                self.warnings.push(format!("style '{other}' unknown"));
+                Style::Gnome
+            }
+        };
+        decor.accent = match pairs.get("accent").map(String::as_str) {
+            None | Some("gnome") => None,
+            Some(value) => {
+                let color = parse_color(value);
+                if color.is_none() {
+                    self.warnings.push(format!("accent '{value}' is not #rrggbb"));
+                }
+                color
+            }
+        };
+        if let Some(value) = pairs.get("background").filter(|value| *value != "none") {
+            decor.background = self.image(base, value);
+        }
+        if let Some(percent) = self.number::<u32>(&pairs, "background.opacity") {
+            decor.background_opacity = percent_to_alpha(percent);
+        }
+        if let Some(percent) = self.number::<u32>(&pairs, "buttons.opacity") {
+            decor.plate_opacity = percent_to_alpha(percent);
+        }
+        if let Some(art) = self.art(base, pairs.get("watermark"), "penguin") {
+            decor.watermark = art;
+        }
+        if let Some(scale) = self.number::<f32>(&pairs, "watermark.scale") {
+            decor.watermark_scale = scale.clamp(0.1, 10.0);
+        }
+        if let Some(percent) = self.number::<u32>(&pairs, "watermark.opacity") {
+            decor.watermark_opacity = percent_to_alpha(percent);
+        }
+        if let Some(x) = self.number::<i32>(&pairs, "watermark.x") {
+            decor.watermark_offset.0 = x.clamp(-2_000, 2_000);
+        }
+        if let Some(y) = self.number::<i32>(&pairs, "watermark.y") {
+            decor.watermark_offset.1 = y.clamp(-2_000, 2_000);
+        }
+        if let Some(art) = self.art(base, pairs.get("mascot"), "tux") {
+            decor.mascot = art;
+        }
+        decor
+    }
+
+    fn load(&mut self, directory: &Path) -> Config {
+        let path = directory.join("touchbar.conf");
+        let pairs = self
+            .read_text(&path)
+            .map(|text| parse_pairs(&text, &mut self.warnings, &path))
+            .unwrap_or_default();
+        let name = pairs.get("theme").map_or("default", String::as_str).to_owned();
+        let theme_directory = (!name.contains('/') && !name.starts_with('.'))
+            .then(|| directory.join("themes").join(&name))
+            .filter(|candidate| candidate.is_dir() || {
+                self.watched.push(candidate.clone());
+                false
+            });
+        let mut decor = self.theme(theme_directory.as_deref(), &name);
+        let mut fn_actions: [Option<FnAction>; FUNCTION_KEYS] = Default::default();
+        for (index, slot) in fn_actions.iter_mut().enumerate() {
+            let key = format!("fn.f{}", index + 1);
+            if let Some(value) = pairs.get(&key) {
+                match parse_action(value) {
+                    Ok(action) => *slot = Some(action),
+                    Err(error) => self.warnings.push(format!("{key}: {error}")),
+                }
+            }
+            if let Some(icon) = pairs.get(&format!("{key}.icon")) {
+                decor.fn_icons[index] = self.image(directory, icon);
+            }
+        }
+        for key in pairs.keys() {
+            let known = key == "theme"
+                || key
+                    .strip_prefix("fn.f")
+                    .map(|rest| rest.trim_end_matches(".icon"))
+                    .and_then(|number| number.parse::<usize>().ok())
+                    .is_some_and(|number| (1..=FUNCTION_KEYS).contains(&number));
+            if !known {
+                self.warnings.push(format!("{}: unknown setting '{key}'", path.display()));
+            }
+        }
+        Config {
+            decor: Arc::new(decor),
+            fn_actions,
+        }
+    }
+}
+
+/// Expands `~/` and resolves relative paths against `base`.
+fn resolve(base: &Path, value: &str) -> PathBuf {
+    if let Some(rest) = value.strip_prefix("~/") {
+        if let Some(home) = env::var_os("HOME") {
+            return PathBuf::from(home).join(rest);
+        }
+    }
+    let path = PathBuf::from(value);
+    if path.is_absolute() {
+        path
+    } else {
+        base.join(path)
+    }
+}
+
+fn fingerprint(paths: &[PathBuf]) -> Vec<Option<(SystemTime, u64)>> {
+    paths
+        .iter()
+        .map(|path| {
+            fs::metadata(path)
+                .ok()
+                .and_then(|metadata| Some((metadata.modified().ok()?, metadata.len())))
+        })
+        .collect()
+}
+
+/// Reloads the configuration whenever any consulted file changes.
+pub struct ConfigWatcher {
+    current: Arc<Mutex<Config>>,
+    generation: Arc<AtomicU64>,
+}
+
+impl ConfigWatcher {
+    #[must_use]
+    pub fn start() -> Self {
+        let current = Arc::new(Mutex::new(Config::default()));
+        let generation = Arc::new(AtomicU64::new(0));
+        let (worker_current, worker_generation) = (Arc::clone(&current), Arc::clone(&generation));
+        thread::spawn(move || {
+            let Some(directory) = config_dir() else {
+                return;
+            };
+            let mut watched: Vec<PathBuf> = Vec::new();
+            let mut stamp = Vec::new();
+            let mut first = true;
+            loop {
+                if first || fingerprint(&watched) != stamp {
+                    first = false;
+                    let mut loader = Loader {
+                        warnings: Vec::new(),
+                        watched: vec![directory.clone()],
+                    };
+                    let config = loader.load(&directory);
+                    for warning in &loader.warnings {
+                        eprintln!("t1-touchbar: config: {warning}");
+                    }
+                    watched = loader.watched;
+                    stamp = fingerprint(&watched);
+                    if let Ok(mut slot) = worker_current.lock() {
+                        *slot = config;
+                    }
+                    worker_generation.fetch_add(1, Ordering::AcqRel);
+                }
+                thread::sleep(POLL_INTERVAL);
+            }
+        });
+        Self {
+            current,
+            generation,
+        }
+    }
+
+    /// Returns the configuration when it changed since `seen`, updating `seen`.
+    pub fn take_if_changed(&self, seen: &mut u64) -> Option<Config> {
+        let generation = self.generation.load(Ordering::Acquire);
+        if generation == *seen {
+            return None;
+        }
+        *seen = generation;
+        self.current.lock().ok().map(|config| config.clone())
+    }
+}
+
