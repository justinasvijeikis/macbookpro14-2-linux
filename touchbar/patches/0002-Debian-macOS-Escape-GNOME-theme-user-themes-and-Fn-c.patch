+//! Small procedural penguin mascot with an accent-colored scarf.
+
+use crate::framebuffer::{FramebufferError, Rectangle, Rgb, Xrgb8888Frame};
+
+/// Native drawing box, in pixels at the 60-pixel panel height.
+pub(crate) const NATIVE_WIDTH: u32 = 44;
+pub(crate) const NATIVE_HEIGHT: u32 = 54;
+const SAMPLE_GRID: u32 = 4;
+
+const BODY: Rgb = Rgb {
+    red: 78,
+    green: 78,
+    blue: 86,
+};
+const WHITE: Rgb = Rgb {
+    red: 244,
+    green: 244,
+    blue: 244,
+};
+const PUPIL: Rgb = Rgb {
+    red: 16,
+    green: 16,
+    blue: 18,
+};
+const ORANGE: Rgb = Rgb {
+    red: 246,
+    green: 166,
+    blue: 35,
+};
+
+/// One ellipse in native box coordinates: center, radii.
+#[derive(Clone, Copy)]
+struct Ellipse(f32, f32, f32, f32);
+
+/// Layers back to front.
+fn layers(accent: Rgb) -> [(Rgb, &'static [Ellipse]); 6] {
+    const BODY_SHAPES: &[Ellipse] = &[
+        Ellipse(22.0, 33.0, 15.0, 18.5), // body
+        Ellipse(22.0, 15.0, 11.5, 11.5), // head
+        Ellipse(8.5, 32.0, 4.0, 11.0),   // left flipper
+        Ellipse(35.5, 32.0, 4.0, 11.0),  // right flipper
+    ];
+    const WHITE_SHAPES: &[Ellipse] = &[
+        Ellipse(22.0, 36.0, 10.0, 14.0), // belly
+        Ellipse(18.0, 13.0, 3.6, 4.6),   // left eye
+        Ellipse(26.0, 13.0, 3.6, 4.6),   // right eye
+    ];
+    const PUPILS: &[Ellipse] = &[Ellipse(18.9, 14.0, 1.7, 2.2), Ellipse(25.1, 14.0, 1.7, 2.2)];
+    const BEAK: &[Ellipse] = &[Ellipse(22.0, 19.5, 5.0, 2.6)];
+    const SCARF: &[Ellipse] = &[Ellipse(22.0, 24.5, 12.5, 2.8), Ellipse(30.0, 29.0, 2.6, 5.0)];
+    const FEET: &[Ellipse] = &[Ellipse(14.5, 51.0, 7.0, 2.8), Ellipse(29.5, 51.0, 7.0, 2.8)];
+    [
+        (BODY, BODY_SHAPES),
+        (WHITE, WHITE_SHAPES),
+        (PUPIL, PUPILS),
+        (ORANGE, BEAK),
+        (accent, SCARF),
+        (ORANGE, FEET),
+    ]
+}
+
+/// Draws the penguin scaled into `bounds` (aspect kept, centered).
+pub(crate) fn draw(
+    frame: &mut Xrgb8888Frame<'_>,
+    bounds: Rectangle,
+    accent: Rgb,
+) -> Result<(), FramebufferError> {
+    #[allow(clippy::cast_precision_loss)]
+    let scale = (bounds.width as f32 / NATIVE_WIDTH as f32)
+        .min(bounds.height as f32 / NATIVE_HEIGHT as f32);
+    if scale <= 0.0 {
+        return Ok(());
+    }
+    #[allow(clippy::cast_possible_truncation, clippy::cast_sign_loss, clippy::cast_precision_loss)]
+    let (width, height) = (
+        ((NATIVE_WIDTH as f32 * scale).ceil() as u32).min(bounds.width),
+        ((NATIVE_HEIGHT as f32 * scale).ceil() as u32).min(bounds.height),
+    );
+    let area = Rectangle {
+        x: bounds.x + (bounds.width - width) / 2,
+        y: bounds.y + (bounds.height - height) / 2,
+        width,
+        height,
+    };
+    for (color, shapes) in layers(accent) {
+        let mask = coverage(shapes, width, height, scale);
+        frame.blend_mask(area, &mask, color)?;
+    }
+    Ok(())
+}
+
+/// Silhouette used by the background pattern (body, head, flippers, feet).
+const SILHOUETTE: &[Ellipse] = &[
+    Ellipse(22.0, 33.0, 15.0, 18.5),
+    Ellipse(22.0, 15.0, 11.5, 11.5),
+    Ellipse(8.5, 32.0, 4.0, 11.0),
+    Ellipse(35.5, 32.0, 4.0, 11.0),
+    Ellipse(14.5, 51.0, 7.0, 2.8),
+    Ellipse(29.5, 51.0, 7.0, 2.8),
+];
+/// White penguin silhouette `height` pixels tall; alpha carries the shape.
+pub(crate) fn silhouette(height: u32) -> crate::png::Image {
+    #[allow(clippy::cast_precision_loss)]
+    let scale = height as f32 / NATIVE_HEIGHT as f32;
+    #[allow(clippy::cast_possible_truncation, clippy::cast_sign_loss, clippy::cast_precision_loss)]
+    let width = ((NATIVE_WIDTH as f32 * scale).ceil() as u32).max(1);
+    let rgba = coverage(SILHOUETTE, width, height, scale)
+        .into_iter()
+        .flat_map(|alpha| [255, 255, 255, alpha])
+        .collect();
+    crate::png::Image {
+        width,
+        height,
+        rgba,
+    }
+}
+
+#[allow(clippy::cast_precision_loss, clippy::cast_possible_truncation, clippy::cast_sign_loss)]
+fn coverage(shapes: &[Ellipse], width: u32, height: u32, scale: f32) -> Vec<u8> {
+    let samples = SAMPLE_GRID * SAMPLE_GRID;
+    let mut mask = Vec::with_capacity((width * height) as usize);
+    for py in 0..height {
+        for px in 0..width {
+            let mut hits = 0;
+            for sy in 0..SAMPLE_GRID {
+                for sx in 0..SAMPLE_GRID {
+                    let x = (px as f32 + (sx as f32 + 0.5) / SAMPLE_GRID as f32) / scale;
+                    let y = (py as f32 + (sy as f32 + 0.5) / SAMPLE_GRID as f32) / scale;
+                    if shapes.iter().any(|&Ellipse(cx, cy, rx, ry)| {
+                        let (dx, dy) = ((x - cx) / rx, (y - cy) / ry);
+                        dx * dx + dy * dy <= 1.0
+                    }) {
+                        hits += 1;
+                    }
+                }
+            }
+            mask.push((hits * 255 / samples) as u8);
+        }
+    }
+    mask
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn penguin_fits_and_paints_inside_bounds_only() {
+        let (w, h) = (100u32, 60u32);
+        let mut pixels = vec![0u8; (w * h * 4) as usize];
+        let mut frame = Xrgb8888Frame::new(w, h, w * 4, &mut pixels).unwrap();
+        let bounds = Rectangle {
+            x: 30,
+            y: 0,
+            width: 50,
+            height: 60,
+        };
+        let accent = Rgb {
+            red: 53,
+            green: 132,
+            blue: 228,
+        };
+        draw(&mut frame, bounds, accent).unwrap();
+        let painted: Vec<u32> = (0..w * h)
+            .filter(|i| pixels[(*i * 4) as usize..(*i * 4 + 3) as usize] != [0, 0, 0])
+            .map(|i| i % w)
+            .collect();
+        assert!(!painted.is_empty());
+        assert!(painted.iter().all(|x| (30..80).contains(x)));
+    }
+}
