+//! Theme art composition: scaled, clipped, alpha-blended RGBA images.
+
+use std::sync::{Arc, OnceLock};
+
+use crate::framebuffer::{FramebufferError, Rectangle, Rgb, Xrgb8888Frame};
+use crate::png::Image;
+use crate::tux;
+
+/// Supersampling grid per output pixel; smooths downscaled art.
+const SAMPLES: u32 = 3;
+
+/// Where and how to place an image.
+#[derive(Clone, Copy, Debug)]
+pub(crate) struct Placement {
+    /// Destination rectangle in panel pixels; may extend past `clip`.
+    pub x: f32,
+    pub y: f32,
+    pub width: f32,
+    pub height: f32,
+    /// Only pixels inside this rectangle (with rounded corners) are touched.
+    pub clip: Rectangle,
+    pub radius: f32,
+    /// Overall opacity multiplied into the image alpha.
+    pub opacity: u8,
+    /// Replaces image color while keeping its alpha (for silhouettes).
+    pub tint: Option<Rgb>,
+}
+
+impl Placement {
+    /// Centers `image` in `bounds` at `height` pixels tall, shifted by `offset`.
+    pub(crate) fn centered(image: &Image, bounds: Rectangle, height: f32, offset: (i32, i32)) -> Self {
+        #[allow(clippy::cast_precision_loss)]
+        let width = height * image.width as f32 / image.height as f32;
+        #[allow(clippy::cast_precision_loss)]
+        Self {
+            x: bounds.x as f32 + (bounds.width as f32 - width) / 2.0 + offset.0 as f32,
+            y: bounds.y as f32 + (bounds.height as f32 - height) / 2.0 + offset.1 as f32,
+            width,
+            height,
+            clip: bounds,
+            radius: 0.0,
+            opacity: 255,
+            tint: None,
+        }
+    }
+
+    /// Scales `image` to cover `bounds` completely (cropping the overflow).
+    pub(crate) fn cover(image: &Image, bounds: Rectangle) -> Self {
+        #[allow(clippy::cast_precision_loss)]
+        let scale = (bounds.width as f32 / image.width as f32)
+            .max(bounds.height as f32 / image.height as f32);
+        #[allow(clippy::cast_precision_loss)]
+        let height = image.height as f32 * scale;
+        Self::centered(image, bounds, height, (0, 0))
+    }
+
+    /// Fits `image` entirely inside `bounds` scaled by `fill`.
+    pub(crate) fn contain(image: &Image, bounds: Rectangle, fill: f32) -> Self {
+        #[allow(clippy::cast_precision_loss)]
+        let scale = (bounds.width as f32 / image.width as f32)
+            .min(bounds.height as f32 / image.height as f32)
+            * fill;
+        #[allow(clippy::cast_precision_loss)]
+        let height = image.height as f32 * scale;
+        Self::centered(image, bounds, height, (0, 0))
+    }
+}
+
+/// Built-in penguin silhouette (white, alpha = coverage), rendered once.
+pub(crate) fn penguin_silhouette() -> Arc<Image> {
+    static SILHOUETTE: OnceLock<Arc<Image>> = OnceLock::new();
+    Arc::clone(SILHOUETTE.get_or_init(|| Arc::new(tux::silhouette(240))))
+}
+
+#[allow(
+    clippy::cast_precision_loss,
+    clippy::cast_possible_truncation,
+    clippy::cast_sign_loss,
+    clippy::cast_possible_wrap
+)]
+pub(crate) fn draw_image(
+    frame: &mut Xrgb8888Frame<'_>,
+    image: &Image,
+    placement: Placement,
+) -> Result<(), FramebufferError> {
+    if placement.width <= 0.0 || placement.height <= 0.0 || placement.opacity == 0 {
+        return Ok(());
+    }
+    let clip = placement.clip;
+    let left = placement.x.floor().max(clip.x as f32) as u32;
+    let top = placement.y.floor().max(clip.y as f32) as u32;
+    let right = ((placement.x + placement.width).ceil() as i64)
+        .min(i64::from(clip.x + clip.width))
+        .max(0) as u32;
+    let bottom = ((placement.y + placement.height).ceil() as i64)
+        .min(i64::from(clip.y + clip.height))
+        .max(0) as u32;
+    if left >= right || top >= bottom {
+        return Ok(());
+    }
+    let area = Rectangle {
+        x: left,
+        y: top,
+        width: right - left,
+        height: bottom - top,
+    };
+    let scale_x = image.width as f32 / placement.width;
+    let scale_y = image.height as f32 / placement.height;
+    let (cl, ct) = (clip.x as f32, clip.y as f32);
+    let (cr, cb) = (cl + clip.width as f32, ct + clip.height as f32);
+    let radius = placement.radius.min(clip.width as f32 / 2.0).min(clip.height as f32 / 2.0);
+    let mut colors = Vec::with_capacity((area.width * area.height) as usize);
+    let mut mask = Vec::with_capacity((area.width * area.height) as usize);
+    for py in area.y..area.y + area.height {
+        for px in area.x..area.x + area.width {
+            let (mut red, mut green, mut blue, mut alpha) = (0u32, 0u32, 0u32, 0u32);
+            for sy in 0..SAMPLES {
+                for sx in 0..SAMPLES {
+                    let x = px as f32 + (sx as f32 + 0.5) / SAMPLES as f32;
+                    let y = py as f32 + (sy as f32 + 0.5) / SAMPLES as f32;
+                    if radius > 0.0 {
+                        let nx = x.clamp(cl + radius, cr - radius);
+                        let ny = y.clamp(ct + radius, cb - radius);
+                        if (x - nx).powi(2) + (y - ny).powi(2) > radius * radius {
+                            continue;
+                        }
+                    }
+                    let ix = ((x - placement.x) * scale_x).floor();
+                    let iy = ((y - placement.y) * scale_y).floor();
+                    if ix < 0.0 || iy < 0.0 || ix >= image.width as f32 || iy >= image.height as f32 {
+                        continue;
+                    }
+                    let [r, g, b, a] = image.pixel(ix as u32, iy as u32);
+                    let a = u32::from(a);
+                    red += u32::from(r) * a;
+                    green += u32::from(g) * a;
+                    blue += u32::from(b) * a;
+                    alpha += a;
+                }
+            }
+            let count = SAMPLES * SAMPLES;
+            let color = match placement.tint {
+                Some(tint) => tint,
+                None if alpha > 0 => Rgb {
+                    red: (red / alpha) as u8,
+                    green: (green / alpha) as u8,
+                    blue: (blue / alpha) as u8,
+                },
+                None => Rgb {
+                    red: 0,
+                    green: 0,
+                    blue: 0,
+                },
+            };
+            colors.push(color);
+            mask.push((alpha / count * u32::from(placement.opacity) / 255) as u8);
+        }
+    }
+    frame.blend_pixels(area, &mask, &colors)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn frame_pixels(width: u32, height: u32) -> Vec<u8> {
+        vec![0; (width * height * 4) as usize]
+    }
+
+    fn solid(width: u32, height: u32, rgba: [u8; 4]) -> Image {
+        Image {
+            width,
+            height,
+            rgba: rgba.repeat((width * height) as usize),
+        }
+    }
+
+    #[test]
+    fn oversized_art_is_clipped_to_its_bounds() {
+        let mut pixels = frame_pixels(40, 10);
+        let mut frame = Xrgb8888Frame::new(40, 10, 160, &mut pixels).unwrap();
+        let clip = Rectangle {
+            x: 10,
+            y: 0,
+            width: 10,
+            height: 10,
+        };
+        let image = solid(4, 4, [255, 0, 0, 255]);
+        let placement = Placement::centered(&image, clip, 40.0, (0, 0));
+        draw_image(&mut frame, &image, placement).unwrap();
+        for x in 0..40u32 {
+            let red = pixels[(x * 4 + 2) as usize];
+            assert_eq!(red == 255, (10..20).contains(&x), "x={x}");
+        }
+    }
+
+    #[test]
+    fn opacity_and_tint_apply() {
+        let mut pixels = frame_pixels(4, 4);
+        let mut frame = Xrgb8888Frame::new(4, 4, 16, &mut pixels).unwrap();
+        let bounds = Rectangle {
+            x: 0,
+            y: 0,
+            width: 4,
+            height: 4,
+        };
+        let image = solid(2, 2, [255, 255, 255, 255]);
+        let mut placement = Placement::cover(&image, bounds);
+        placement.opacity = 128;
+        placement.tint = Some(Rgb {
+            red: 0,
+            green: 200,
+            blue: 0,
+        });
+        draw_image(&mut frame, &image, placement).unwrap();
+        assert_eq!(&pixels[0..4], &[0, 100, 0, 0]);
+    }
+}
