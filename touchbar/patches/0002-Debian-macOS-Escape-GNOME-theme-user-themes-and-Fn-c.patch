+
+    /// Blends per-pixel colors with per-pixel alpha over an in-bounds rectangle.
+    ///
+    /// # Errors
+    ///
+    /// Returns [`FramebufferError::RectangleOutOfBounds`] when the rectangle is
+    /// empty or outside the frame, or when either slice is not `width * height`.
+    pub fn blend_pixels(
+        &mut self,
+        rectangle: Rectangle,
+        mask: &[u8],
+        colors: &[Rgb],
+    ) -> Result<(), FramebufferError> {
+        let expected = usize::try_from(u64::from(rectangle.width) * u64::from(rectangle.height))
+            .map_err(|_| FramebufferError::RectangleOutOfBounds)?;
+        if rectangle.width == 0
+            || rectangle.height == 0
+            || mask.len() != expected
+            || colors.len() != expected
+            || rectangle.x.checked_add(rectangle.width).is_none_or(|right| right > self.width)
+            || rectangle.y.checked_add(rectangle.height).is_none_or(|bottom| bottom > self.height)
+        {
+            return Err(FramebufferError::RectangleOutOfBounds);
+        }
+        let width = usize::try_from(rectangle.width).unwrap_or(0);
+        for row in 0..rectangle.height {
+            for column in 0..rectangle.width {
+                let index = usize::try_from(row).unwrap_or(0) * width
+                    + usize::try_from(column).unwrap_or(0);
+                let alpha = u16::from(mask[index]);
+                if alpha == 0 {
+                    continue;
+                }
+                let offset = usize::try_from(
+                    u64::from(rectangle.y + row) * u64::from(self.stride)
+                        + u64::from(rectangle.x + column) * u64::from(BYTES_PER_PIXEL),
+                )
+                .map_err(|_| FramebufferError::RectangleOutOfBounds)?;
+                let pixel = self
+                    .pixels
+                    .get_mut(offset..offset + 4)
+                    .ok_or(FramebufferError::RectangleOutOfBounds)?;
+                let color = colors[index];
+                pixel[0] = blend_channel(pixel[0], color.blue, alpha);
+                pixel[1] = blend_channel(pixel[1], color.green, alpha);
+                pixel[2] = blend_channel(pixel[2], color.red, alpha);
+            }
+        }
+        Ok(())
+    }
 }
 
