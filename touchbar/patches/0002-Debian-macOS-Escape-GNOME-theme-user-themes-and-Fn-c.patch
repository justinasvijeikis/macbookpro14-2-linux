+++ b/debian/uninstall-touchbar.sh
@@ -0,0 +1,21 @@
+#!/bin/bash
+# Atšaukia install-touchbar.sh. Po to perkrauti — T1 grįš į config 1 su stock uvcvideo.
+set -uo pipefail
+[ "$(id -u)" = 0 ] || { echo "Paleisk per sudo" >&2; exit 1; }
+VER=0.1.12+deb612
+
+systemctl --global disable t1-touchbar.service
+systemctl disable --now t1-touchbar-hw.service t1-touchbar-hw.socket
+rm -f /etc/systemd/system/t1-touchbar-hw.{service,socket} /etc/systemd/user/t1-touchbar.service \
+      /etc/udev/rules.d/99-zz-t1bridge-touchbar.rules /etc/sysusers.d/t1bridge.conf \
+      /etc/tmpfiles.d/t1bridge.conf /etc/modules-load.d/t1bridge.conf /etc/modprobe.d/t1bridge.conf
+rm -rf /usr/lib/t1bridge
+rm -rf /etc/systemd/user/t1-touchbar.service.d
+rm -f /etc/udev/rules.d/39-usbmuxd.rules  # grąžina Debian'o usbmuxd taisyklę
+sed -i '/^t1_cfgsel$/d' /etc/initramfs-tools/modules
+dkms remove -m t1bridge-dkms -v "$VER" --all
+rm -rf "/usr/src/t1bridge-dkms-$VER"
+update-initramfs -u -k "$(uname -r)"
+systemctl daemon-reload
+udevadm control --reload
+echo "Pašalinta. Grupė t1bridge palikta (nekenksminga): groupdel t1bridge"
