@@ -0,0 +1,242 @@
+//! GNOME interface theme (accent color and light/dark style) for the built-in surface.
+//!
+//! The watcher runs the unprivileged `gsettings` client in the user session;
+//! a missing client or non-GNOME desktop simply keeps the default palette.
+
+use std::io::{BufRead, BufReader};
+use std::process::{Command, Stdio};
+use std::sync::atomic::{AtomicU64, Ordering};
+use std::sync::{Arc, Mutex};
+use std::thread;
+use std::time::Duration;
+
+use crate::framebuffer::Rgb;
+
+const SCHEMA: &str = "org.gnome.desktop.interface";
+const RESTART_DELAY: Duration = Duration::from_secs(5);
+
+const fn rgb(red: u8, green: u8, blue: u8) -> Rgb {
+    Rgb { red, green, blue }
+}
+
+/// Colors used by the stock surface.
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+pub struct Theme {
+    pub dark: bool,
+    pub background: Rgb,
+    pub plate: Rgb,
+    pub pressed_plate: Rgb,
+    pub label: Rgb,
+    pub pressed_label: Rgb,
+    pub accent: Rgb,
+}
+
+impl Theme {
+    /// The original neutral palette, used when no desktop theme is known.
+    pub const DEFAULT: Self = Self {
+        dark: true,
+        background: rgb(0, 0, 0),
+        plate: rgb(53, 53, 53),
+        pressed_plate: rgb(76, 76, 76),
+        label: rgb(242, 242, 242),
+        pressed_label: rgb(242, 242, 242),
+        accent: rgb(53, 132, 228),
+    };
+
+    /// Adwaita-style plates; the background stays black so the OLED blends with the bezel.
+    #[must_use]
+    pub const fn adwaita(dark: bool, accent: Rgb) -> Self {
+        let (plate, label) = if dark {
+            (rgb(58, 58, 62), rgb(242, 242, 242))
+        } else {
+            (rgb(222, 222, 226), rgb(46, 46, 50))
+        };
+        Self {
+            dark,
+            background: rgb(0, 0, 0),
+            plate,
+            pressed_plate: accent,
+            label,
+            pressed_label: rgb(255, 255, 255),
+            accent,
+        }
+    }
+}
+
+impl Default for Theme {
+    fn default() -> Self {
+        Self::DEFAULT
+    }
+}
+
+/// GNOME 47+ accent palette (`accent-color` key).
+fn accent_rgb(name: &str) -> Option<Rgb> {
+    Some(match name {
+        "blue" => rgb(53, 132, 228),
+        "teal" => rgb(33, 144, 164),
+        "green" => rgb(58, 148, 74),
+        "yellow" => rgb(200, 136, 0),
+        "orange" => rgb(237, 91, 0),
+        "red" => rgb(230, 45, 66),
+        "pink" => rgb(213, 97, 153),
+        "purple" => rgb(145, 65, 172),
+        "slate" => rgb(111, 131, 150),
+        _ => return None,
+    })
+}
+
+#[derive(Clone, Debug, Eq, PartialEq)]
+struct Settings {
+    accent: String,
+    color_scheme: String,
+}
+
+impl Settings {
+    fn theme(&self) -> Theme {
+        Theme::adwaita(
+            self.color_scheme != "prefer-light",
+            accent_rgb(&self.accent).unwrap_or(Theme::DEFAULT.accent),
+        )
+    }
+
+    /// Applies one `gsettings monitor` line such as `accent-color: 'teal'`.
+    fn apply_line(&mut self, line: &str) -> bool {
+        let Some((key, value)) = line.split_once(':') else {
+            return false;
+        };
+        let value = unquote(value);
+        let slot = match key.trim() {
+            "accent-color" => &mut self.accent,
+            "color-scheme" => &mut self.color_scheme,
+            _ => return false,
+        };
+        if *slot == value {
+            return false;
+        }
+        *slot = value;
+        true
+    }
+}
+
+fn unquote(value: &str) -> String {
+    value.trim().trim_matches('\'').to_owned()
+}
+
+fn gsettings_get(key: &str) -> Option<String> {
+    let output = Command::new("gsettings")
+        .args(["get", SCHEMA, key])
+        .stdin(Stdio::null())
+        .stderr(Stdio::null())
+        .output()
+        .ok()?;
+    output
+        .status
+        .success()
+        .then(|| unquote(&String::from_utf8_lossy(&output.stdout)))
+}
+
+/// Follows the desktop theme on a background thread.
+pub struct ThemeWatcher {
+    current: Arc<Mutex<Theme>>,
+    generation: Arc<AtomicU64>,
+}
+
+impl ThemeWatcher {
+    #[must_use]
+    pub fn start() -> Self {
+        let current = Arc::new(Mutex::new(Theme::DEFAULT));
+        let generation = Arc::new(AtomicU64::new(0));
+        let worker_current = Arc::clone(&current);
+        let worker_generation = Arc::clone(&generation);
+        thread::spawn(move || watch(&worker_current, &worker_generation));
+        Self {
+            current,
+            generation,
+        }
+    }
+
+    /// Returns the theme when it changed since `seen`, updating `seen`.
+    pub fn take_if_changed(&self, seen: &mut u64) -> Option<Theme> {
+        let generation = self.generation.load(Ordering::Acquire);
+        if generation == *seen {
+            return None;
+        }
+        *seen = generation;
+        self.current.lock().ok().map(|theme| *theme)
+    }
+}
+
+fn watch(current: &Mutex<Theme>, generation: &AtomicU64) {
+    let publish = |settings: &Settings| {
+        if let Ok(mut theme) = current.lock() {
+            *theme = settings.theme();
+        }
+        generation.fetch_add(1, Ordering::AcqRel);
+    };
+    loop {
+        let (Some(accent), Some(color_scheme)) =
+            (gsettings_get("accent-color"), gsettings_get("color-scheme"))
+        else {
+            thread::sleep(RESTART_DELAY);
+            continue;
+        };
+        let mut settings = Settings {
+            accent,
+            color_scheme,
+        };
+        publish(&settings);
+        if let Ok(mut child) = Command::new("gsettings")
+            .args(["monitor", SCHEMA])
+            .stdin(Stdio::null())
+            .stdout(Stdio::piped())
+            .stderr(Stdio::null())
+            .spawn()
+        {
+            if let Some(stdout) = child.stdout.take() {
+                for line in BufReader::new(stdout).lines() {
+                    let Ok(line) = line else { break };
+                    if settings.apply_line(&line) {
+                        publish(&settings);
+                    }
+                }
+            }
+            let _ = child.kill();
+            let _ = child.wait();
+        }
+        thread::sleep(RESTART_DELAY);
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn settings() -> Settings {
+        Settings {
+            accent: "blue".into(),
+            color_scheme: "prefer-dark".into(),
+        }
+    }
+
+    #[test]
+    fn monitor_lines_update_only_known_changed_keys() {
+        let mut s = settings();
+        assert!(!s.apply_line("accent-color: 'blue'"));
+        assert!(!s.apply_line("font-name: 'Cantarell 11'"));
+        assert!(!s.apply_line("garbage"));
+        assert!(s.apply_line("accent-color: 'teal'"));
+        assert_eq!(s.theme().accent, accent_rgb("teal").unwrap());
+        assert!(s.apply_line("color-scheme: 'prefer-light'"));
+        assert_eq!(s.theme().pressed_plate, s.theme().accent);
+        assert_ne!(s.theme().plate, settings().theme().plate);
+    }
+
+    #[test]
+    fn unknown_accent_and_default_scheme_fall_back_to_dark_blue() {
+        let s = Settings {
+            accent: "chartreuse".into(),
+            color_scheme: "default".into(),
+        };
+        assert_eq!(s.theme(), Theme::adwaita(true, Theme::DEFAULT.accent));
+    }
+}
