+Savo tema: sukurk katalogą themes/<vardas>/ su theme.conf ir PNG failais,
+tada touchbar.conf įrašyk: theme = <vardas>
+
+theme.conf (visi nustatymai neprivalomi):
+  style = gnome            # gnome (seka sistemą) | dark | light
+  accent = gnome           # gnome | #rrggbb
+  background = fonas.png   # visos juostos paveikslėlis (juosta 2170x60, tinka 1085x30 ir pan.)
+  background.opacity = 100 # %
+  buttons.opacity = 100    # % - mažiau = fonas matosi pro mygtukus
+  watermark = penguin      # none | penguin | failas.png - kiekvieno mygtuko fone
+  watermark.scale = 0.9    # x mygtuko aukštis; >1 = didesnis, apkerpamas
+  watermark.opacity = 13   # %
+  watermark.x = 0          # poslinkis pikseliais
+  watermark.y = 0
+  mascot = tux             # none | tux | failas.png - tarpe po ESC
+
+PNG: 8 bitų, ne interlaced (taip saugo GIMP/Inkscape pagal nutylėjimą).
